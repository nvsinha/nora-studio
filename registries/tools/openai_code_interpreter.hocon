# The schema specifications for this file are documented here:
# https://github.com/nvsinha/nora-fleet/blob/main/docs/agent_hocon_reference.md

# Requirement to use this agent network:
# - langchain-openai >= 0.3.26
# - OPENAI_API_KEY
# See https://platform.openai.com/docs/guides/tools?api-mode=responses and
# https://python.langchain.com/docs/integrations/chat/openai/#responses-api

{
    include "registries/expertise_scoping_instructions.hocon",

    # Load the shared LLM configuration from a single source of truth.
    # This allows users to change the model in one file rather than
    # modifying the configuration for each agent network.
    # Note that the file path here is relative to the root level of the repo.
    include "config/llm_config.hocon",

    # Optional metadata describing this agent network
    "metadata": {
        "description": "Code interpreter assistant that leverages OpenAI's built-in code interpreter tool to run Python code, generate visualizations, perform data analysis, and create computational solutions through natural language commands.",
        "tags": ["openai", "tool", "code-interpreter"],
        "sample_queries": [
            "Can you analyze the sales data I have and create a comprehensive report with visualizations? The data shows: Q1: $120K, Q2: $150K, Q3: $135K, Q4: $180K.",
        ]
    },

    "tools": [
        # This first agent definition is regarded as the "Front Man", which
        # does all the talking to the outside world/client.
        #
        # Some disqualifications from being a front man:
        #   1) Cannot use a CodedTool "class" definition
        #   2) Cannot use a Tool "toolbox" definition
        #
        # Besides the first agent being the front man, these tool definitions
        # do not have to be in any particular order. How they are linked and
        # call each other is defined within their own specs.
        # This could be a graph, potentially even with cycles.
        {
            "name": "coder",

            "function": {
                # The description acts as an initial prompt. 
                "description": "Assist caller using openai code interpreter.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "user_inquiry": {
                            "type": "string",
                            "description": "An inquiry from a user."
                        },
                    },
                    "required": ["user_inquiry"]
                }
            },

            "instructions": """Use your tool to respond to the inquiry.
""" ${expertise_scoping_instructions},
            "tools": ["code_interpreter"]
        },
        {
            "name": "code_interpreter",            
            "toolbox": "openai_code_interpreter",

            # --- Optional Arguments ---
            "args": {
                # OpenAI model calls the built-in web search tool. Default to gpt-4o-2024-08-06.
                "openai_model": "gpt-4.1"
            }
        },
    ]
}
