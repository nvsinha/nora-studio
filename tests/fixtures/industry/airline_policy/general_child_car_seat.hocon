# This file defines everything necessary for a data-driven test.
# The schema specifications for this file are documented here:
# https://github.com/nvsinha/nora-fleet/blob/main/docs/test_case_hocon_reference.md

{
    # Describes what agent to test against.
    "agent": "industry/airline_policy",

    # success_ratio is useful for passing to the assessor to find out why
    # a test is intermitently failing. Sometimes it's the agent prompt, but
    # sometimes it's the test itself.
    # Note: This number was set to 2/3 as this is a hard regression test case.
    "success_ratio": "2/3",

    # Interactions are a series of dictionaries with request elements paired with
    # descriptions of response checks.
    "interactions": [
        {
            # This is to enable streaming_chat contents to thinking file for debug.
            # "chat_filter": "MAXIMAL",

            # Timeout for each interaction.
            # It's also possible to have a timeout_in_seconds for the entire test.
            "timeout_in_seconds": 180,
            
            # This is what we send as input to streaming_chat()
            "text": """
Can my child use a car seat on the plane, and where should it be placed?
""",

            # The response block treats how we are going to test what comes back
            "response": {

                # Text block says how we are going to examine the text of the response.
                "text": {

                    # Gist says we are going to ask an LLM about how the response
                    # matches up to our description of acceptance criteria.
                    # Each component of the list needs to pass muster in order to pass.
                    "gist": ["""
- Confirms that FAA-approved car seats (manufactured after 1985 with a certification sticker) may be used on the flight.
- States that car seats must be secured to the airplane seat and placed in a window seat.
- Confirms that children must remain in their car seat during takeoff, landing, and periods of turbulence.
- Mentions that car seats are not allowed in the emergency exit row, and not allowed in Polaris business class on Boeing 767, 777, or 787 planes.
- Notes that some exceptions may apply.
                             """]
                }
            }
        }
    ]
}